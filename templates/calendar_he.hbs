<!DOCTYPE html>
<html lang="he">
<head>

  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->

  <meta name="description" content="{{event.name2}}">
  <meta name="author" content="{{event.organizer_name}}">

  <title>{{event.name2}}</title>

  <!-- Bootstrap core CSS -->
  <!-- Latest compiled and minified CSS -->
  {{> fonts}}
  <link rel="stylesheet" href="assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="assets/css/schedule.css">
  {{#if event.theme}}<link rel="stylesheet" href="assets/css/themes/{{event.theme}}.css">{{/if}}
  <link rel="manifest" href="manifest.json">
  <link rel="apple-touch-icon" href="{{event.icon}}"/>

  {{> analytics}}

  <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
      <![endif]-->
</head>

<body dir="rtl">
  <a id="top"></a>
  {{> navbar_he}}

  <div class="main container wide-container" id="session-list">
    <div class="row">
      <div class="middle col-sm-12">
        <h2 class="filter-heading track-heading text-center">
        <span>
          לוח זמנים
        </span>
        </h2>
      </div>
    </div>

    <div class="date-list container">
      <div class="tabs" {{#if hideRoomsList2}}style="display: none"{{/if}}>
        <span class="tabs-nav">
          <a href="#" class="all tabs-nav-link date-button is-active"> כל הימים </a>
          {{#each roomsList2}}
          <a href="#" class="{{slug}} tabs-nav-link date-button"> {{date_short_he}} </a>
          {{/each}}
        </span>
      </div>
    </div>

    <!-- search row: stays visible under the menu while scrolling -->
    <div class="date-list container search-sticky">
      <div class="search">
        <span class="filter search-filter search-filter-schedule">
          <input class="search-filter-input grid-search" type="text" data-find="1" enterkeyhint="search" placeholder="חיפוש">
        </span>
        <span class="filter show-button-filter">
          <button class="btn btn-default bookmark-toggle grid-favorites-toggle" data-favorites-key="{{event.name}}" type="button" title="הצג רק מפגשים מועדפים"><i class="fa fa-star" aria-hidden="true"></i>&nbsp;<span class="bookmark-toggle-label">הלימוד שלי</span></button>
        </span>
      </div>
    </div>

    <div class="row">
      <div class="button-list container pull-left">
        <span class="zoom-controls"><button class="btn btn-default" type="button" data-zoom="out" title="-"><i class="fa fa-search-minus" aria-hidden="true"></i></button><button class="btn btn-default zoom-level" type="button" data-zoom="reset">100%</button><button class="btn btn-default" type="button" data-zoom="in" title="+"><i class="fa fa-search-plus" aria-hidden="true"></i></button></span>
        <button class="btn btn-default export-png" type="button">
          <i class="fa fa-download" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div class="row">
      <div class="col-md-12 calendar-view" data-favorites-key="{{event.name}}">
        <div id="track-list" class="container wide-container">
        {{#each roomsList2}}
            <div class="{{slug}} calendar day-filter" data-date="{{slug}}" data-start="{{start_time}}">
              <div class="col-md-12 paddingzero">
                <a class="anchor" id="{{slug}}"></a>
                <h5 class="text">{{date_he}}</h5>
              </div>
              <div class="calendar-content">
                <div class="times">
                  <div class="time" style="height: calc({{{timeToPixelOffset}}}px * var(--zy, 1))">
                    &nbsp;
                  </div>
                  {{#each timeline}}
                  <div class="time" style="height: calc({{{../timeToPixel}}}px * var(--zy, 1)); line-height: calc({{{../timeToPixel}}}px * var(--zy, 1))">
                    {{time}}
                  </div>
                  {{/each}}
                  {{#each time_labels}}
                  <div class="time time-label" style="top: calc({{{top}}}px * var(--zy, 1))">{{time}}</div>
                  {{/each}}
                </div>
                <div class="rooms" style="height: calc({{{height}}}px * var(--zy, 1));background-image: url('assets/img/timeline{{{timeToPixel}}}.png');background-repeat: repeat;">
                  {{#each rooms}}
                  <div class="room" style="width: calc({{{../width}}} * var(--zx, 1));">
                    <div class="room-header" style="height: calc({{{../timeToPixel}}}px * var(--zy, 1));">
                      {{#if name2}}
                        <span>{{name2}}</span>
                      {{/if}}
                    </div>
                    <div>
                      {{#each sessions}}
                      <div id="session-{{session_id}}" class="session find-container" style="top: calc({{{top}}}px * var(--zy, 1)); height: calc({{{height}}}px * var(--zy, 1));background-color:{{{color}}};">
                        {{#if shabbat}}
                        <div class="language-ribbon-calendar shabbat-ribbon"><span>שבת</span></div>
                        {{else}}
                        {{#if ../../../event.second_language_ribbon}}
                          {{#if language_ribbon}}
                        <div class="language-ribbon-calendar"><span>{{language_ribbon}}</span></div>
                          {{/if}}
                        {{/if}}
                        {{/if}}
                        <div class="session-name">
                          <a href="schedule_he.html#{{session_id}}" class="find-target">
                            {{title2}}
                          </a>
                          <div class="session-details find-target">
                        {{#if speakers_list}}
                            <br>
                          {{#if alt_presenter_summary2}}
                            {{alt_presenter_summary2}}
                          {{else}}
                          {{#each speakers_list}}
                            {{title}}{{name2_first_last}}{{#unless last}},{{/unless}}
                          {{/each}}
                          {{/if}}
                        {{/if}}
                            <div class="session-details-data">
                            <br>
                            {{start}}
                        {{#if location2}}
                            &nbsp;|&nbsp; <span style="white-space: nowrap">{{location2}}</span>
                        {{/if}}
                        {{#if language_short}}
                            &nbsp;|&nbsp; <span style="white-space: nowrap">{{language_short}}</span>
                            {{#if language_translate}}
                            <i class="fas fa-headphones-alt"></i>
                            {{/if}}
                        {{/if}}
                            </div>
                          </div>
                        </div>
                      </div>
                      {{/each}}
                    </div>
                  </div>
                  {{/each}}
                  <div class="calendar-footer"></div>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      </div>

      <div class="track-names track-names-grid">
      {{#each tracks}}
      {{#if name2}}
        <ul class="title-inline title-legend">
          <li  style="background-color:{{{color}}}" class="titlecolor"></li>
          <li>{{name2}}</li>
        </ul>
      {{/if}}
      {{/each}}
      </div>
    </div>
  </div>

  <div class="modal fade" id="saveModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog vertical-align-center">
      <div class="modal-content">
        <div class="modal-header">
          <h3>יצירת קובץ PNG</h3>
        </div>
        <div class="modal-body">
          <p>נא להמתין כמה שניות עד סיום התהליך.</p>
        </div>
      </div>
    </div>
  </div>

  {{> footer_he}}

  <a class="scroll" href="#" id="down-button" data-scroll-direction="0">
    <i class="fa fa-chevron-up" aria-hidden="true"></i>
  </a>
  <script src="assets/js/scroll.js" type="text/javascript"></script>

  <a class="now" href="#" id="now-button" data-scroll-direction="0">
    <i class="fa fa-clock" aria-hidden="true"></i>
  </a>
  <script src="assets/js/scroll_now.js" type="text/javascript"></script>


  <script src="assets/js/async.min.js" type="text/javascript"></script>
  <script src="assets/js/FileSaver.js" type="text/javascript"></script>
  <script src="assets/js/html2canvas.min.js" type="text/javascript"></script>
  <script src="assets/js/calendar_zoom.js" type="text/javascript"></script>
  <script src="assets/js/calendar_extras.js" type="text/javascript"></script>
  <script src="assets/js/favorites_count.js" type="text/javascript"></script>
  <script src="assets/js/sticky_search.js" type="text/javascript"></script>
  <script type="text/javascript">
    $(document).ready(function() {
      function getCurrentDate() {
        var className = '';
        $('.date-button').each(function() {
          if($(this).hasClass('is-active')) {
            className = $(this).attr('class').split(' ')[0];
          }
        });
        return className;
      }
      $('.date-button').click(function() {
        let date = $(this).attr('class').split(' ')[0];
        $(this).addClass('is-active');
        $(this).siblings().removeClass('is-active');
        $('.day-filter').each(function () {
          const showThing = date === 'all' || $(this).hasClass(date);
          $(this).toggleClass('hide', !showThing);
        });
      });

      $(".export-png").click(function() {
        $('#saveModal').modal('show'); document.body.classList.add('exporting');
        let maxWidth = 0;
        let initialWidth = [];
        let count = 0;
        let widthOfChild = 0;
        $('.calendar').each(function() {
          let $timeline = $(this);
          initialWidth[count] = $timeline.width();
          let numberOfChildElements = $timeline.find('.rooms')[0].childElementCount - 1;
          widthOfChild = $timeline.find('.room').width() + 3;
          let canvasWidth = numberOfChildElements * widthOfChild + 50;
          $timeline.width(canvasWidth);
          if(canvasWidth > maxWidth){
            maxWidth = canvasWidth;
          }
          count++;
        });

        $timeline = $('.calendar').parent()[0];
        // html2canvas creates some weird offset for RTL text block - try to compensate for it
        html2canvas($timeline,{backgroundColor: getComputedStyle(document.body).backgroundColor, scale: Math.min(window.devicePixelRatio || 1, 1.5), width: maxWidth, windowWidth: maxWidth, x: -widthOfChild * 2 - 100}).then(function(canvas) {
          canvas.id = "generated-canvas";
          canvas.toBlob(function(blob) {
            $('#saveModal').modal('hide');
            saveAs(blob, 'limmud-calendar-he.png'); document.body.classList.remove('exporting');
          });
        });

        count = 0;
        $('.calendar').each(function() {
          $(this).width(initialWidth[count]);
          count++;
        });
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
        const elems = document.getElementsByClassName('rooms');
        var elemsData = [];

        for (var i = 0; i < elems.length; i++) {
            elems[i].style.cursor = 'grab';

            const mouseDownHandler = function (i, e) {
                if (e.srcElement && e.srcElement.nodeName == 'A') {
                    return;
                }

                elemsData[i].left = elems[i].scrollLeft;
                elemsData[i].x = e.clientX;

                document.addEventListener('mousemove', elemsData[i].move);
                document.addEventListener('mouseup', elemsData[i].up);

                elems[i].style.cursor = 'grabbing';
                elems[i].style.userSelect = 'none';
            };

            const mouseMoveHandler = function (i, e) {
                const dx = e.clientX - elemsData[i].x;
                elems[i].scrollLeft = elemsData[i].left - dx;
            };

            const mouseUpHandler = function (i) {
                document.removeEventListener('mousemove', elemsData[i].move);
                document.removeEventListener('mouseup', elemsData[i].up);

                elems[i].style.cursor = 'grab';
                elems[i].style.removeProperty('user-select');
            };

            elemsData.push({ left: 0, x: 0, down: mouseDownHandler.bind(null, i), move: mouseMoveHandler.bind(null, i), up: mouseUpHandler.bind(null, i)});
            elems[i].addEventListener('mousedown', elemsData[i].down);
        }
    });
  </script>

</body>
</html>
