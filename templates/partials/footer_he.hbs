
<div class="footer-container" dir="ltr">
  <footer class="classic">
    <div class="container">
      <div class="row ui-sortable">
        <div  style="margin-bottom: 14px;" class="col-xs-12 text-center footer-copyright">
         {{#if event.copyright}}
         {{#if event.copyright.licence}}
         <p>
         <a href="{{{event.copyright.licence_url}}}"> <img src="{{{event.copyright.logo}}}"> </a>
         &copy; {{event.copyright.year}}
         <a href="{{{event.copyright.holder_url}}}">{{event.copyright.holder}}</a>
         <!--
         <br>
         The website and it's contents are licensed under
          <a href="{{{event.copyright.licence_url}}}"> {{event.copyright.licence}} </a>
         -->
         </p>
         {{/if}}
        {{/if}}
        </div>
  </div>
  <div class="row ui-sortable">
    <div class="col-sm-12 text-center">
      <ul class="social-profiles">
        {{#each event.social_links}}
          <li><a href="{{link}}"><i class="fab fa-lg fa-{{icon}}" aria-hidden="true" title="{{{name}}}"></i></a></li>
        {{/each}}
        {{#if event.email}}
          <li><a href="mailto:{{event.email}}"><i class="fas fa-lg fa-envelope" aria-hidden="true" title="{{event.email}}"></i></a></li>
        {{/if}}
      </ul>
    </div>
  </div>
</div>
</footer>
</div>

