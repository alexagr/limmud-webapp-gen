// Generated by generate.php - version {{ folderHash }}
var CACHE_NAME = '{{ folderHash }}';

// Everything the app needs offline. Saved BEFORE this version takes over,
// so the previous version stays usable until the new one is complete.
var PRECACHE = {{{ precacheJson }}};

// Third-party hosts whose (opaque) responses may be cached, e.g. Google Fonts
var CACHEABLE_HOSTS = ['fonts.googleapis.com', 'fonts.gstatic.com'];

self.addEventListener('install', function(event) {
  event.waitUntil(
    caches.open(CACHE_NAME).then(function(cache) {
      // add files one by one: a single missing file must not break the whole install
      return Promise.all(PRECACHE.map(function(url) {
        var download = function() {
          return cache.add(new Request(url, {cache: 'reload'}));
        };
        // versioned files (photos: x.jpg?v=<mtime>) never change under the same URL -
        // reuse the copy from the previous version's cache instead of downloading it again
        var reuse = url.indexOf('?v=') !== -1
          ? caches.match(url).then(function(old) { return old ? cache.put(url, old) : download(); })
          : download();
        return reuse.catch(function(err) {
          console.log('precache failed for ' + url, err);
        });
      }));
    })
  );
});

self.addEventListener('activate', function(event) {
  event.waitUntil(
    caches.keys().then(function(cacheNames) {
      return Promise.all(cacheNames.map(function(cacheName) {
        if (cacheName !== CACHE_NAME) {
          console.log('Deleting cache ' + cacheName);
          return caches.delete(cacheName);
        }
      }));
    }).then(function() {
      return self.clients.claim();
    })
  );
});

function isCacheable(request, response) {
  if (!response) return false;
  if (request.url.indexOf('sw.js') !== -1 || request.url.indexOf('notify.json') !== -1) return false;
  if (response.type === 'basic') return response.status === 200;
  var host = new URL(request.url).hostname;
  return CACHEABLE_HOSTS.indexOf(host) !== -1 && (response.type === 'opaque' || response.status === 200);
}

self.addEventListener('fetch', function(event) {
  var request = event.request;
  if (request.method !== 'GET') {
    return;  // let the browser handle anything that is not a plain GET
  }

  event.respondWith(
    caches.match(request, {ignoreSearch: request.mode === 'navigate'}).then(function(cached) {
      if (cached) {
        return cached;
      }
      return fetch(request.clone()).then(function(response) {
        if (isCacheable(request, response)) {
          var copy = response.clone();
          caches.open(CACHE_NAME).then(function(cache) { cache.put(request, copy); });
        }
        return response;
      }).catch(function(err) {
        var accept = request.headers.get('Accept') || '';
        if (request.mode === 'navigate' || accept.indexOf('text/html') !== -1) {
          return caches.match('assets/offline.html');
        }
        if (request.destination === 'image' || accept.indexOf('image') !== -1) {
          return caches.match('assets/img/avatar.png');
        }
        console.log(err);
        return Response.error();
      });
    })
  );
});

self.addEventListener('message', function(event) {
  if (event.data && event.data.action === 'skipWaiting') {
    self.skipWaiting();
  }
});
